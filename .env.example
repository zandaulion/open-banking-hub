# Bank Hub settings. `bankhub init` creates the real file at $BANKHUB_DATA_DIR/.env
# (default ~/.local/share/bankhub/.env). Never commit the real file.

# From the Enable Banking Control Panel (your production application).
ENABLE_BANKING_APP_ID=00000000-0000-0000-0000-000000000000
# The private key whose public half you registered with that application.
BANKHUB_KEY_PATH=/path/to/data/secrets/enable_banking.pem

# Where you reach the app, on your private network (no trailing slash). The cookie is
# scoped to its path. Register <this>/callback as a redirect URL to link banks from the app.
PUBLIC_BASE_URL=https://your-machine.your-tailnet.ts.net:8446
BANKHUB_REDIRECT_URL=https://your-machine.your-tailnet.ts.net:8446/callback

# Loopback ports the app listens on.
WEB_PORT=8041
ADMIN_PORT=8141

# Optional: enables the admin API (invites/devices over HTTP) for an external console.
# Generate 32 random bytes as 64 hex characters. Leave unset to keep it off.
# ADMIN_TOKEN=

# Optional.
# BANKHUB_COUNTRY=RO          # country used to list banks
# BANKHUB_ONE_OFF_RON=50000   # payments at or above this are one-offs, kept out of totals
# COOKIE_PATH=/               # only if you need to override the path taken from PUBLIC_BASE_URL

# Optional: the AI assistant endpoint for Claude's custom connectors (`bankhub mcp-http`; docs/DEPLOY.md).
# BANKHUB_MCP_URL=https://bank-mcp.example.com
# BANKHUB_MCP_PORT=8241
# BANKHUB_MCP_ALLOWED_NETS=
