# Copy to ~/.config/systemd/user/ and replace /path/to/personal-bank-hub.
[Unit]
Description=Personal Bank Hub sync (read-only PSD2)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/path/to/personal-bank-hub
ExecStart=/path/to/personal-bank-hub/.venv/bin/bankhub sync
Nice=10
