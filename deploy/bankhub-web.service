# Copy to ~/.config/systemd/user/ and replace /path/to/personal-bank-hub.
[Unit]
Description=Bank Hub web app (loopback only; publish it through a private reverse proxy)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/personal-bank-hub
ExecStart=/path/to/personal-bank-hub/.venv/bin/bankhub web
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
